{
  "source": "https://sci.hainanu.edu.cn/strawberry/api/v1/ai/agent/tools",
  "checkedOn": "2026-10-09",
  "tools": [
    {
      "name": "database_status",
      "description": "Report availability of the read-only strawberry data tools.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {},
        "required": []
      }
    },
    {
      "name": "literature_search",
      "description": "Retrieve curated evidence, licensed full text and verified plant-scoped strawberry abstracts with hybrid BM25 and semantic search.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "question": {
            "maxLength": 500,
            "type": "string",
            "minLength": 1,
            "description": "Strawberry research question"
          },
          "limit": {
            "type": "integer",
            "maximum": 8,
            "minimum": 1,
            "description": "Maximum ranked sources"
          }
        },
        "required": [
          "question"
        ]
      }
    },
    {
      "name": "gene_resolve",
      "description": "Resolve a gene identifier to exact species and assembly candidates.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "gene_id": {
            "maxLength": 128,
            "type": "string",
            "minLength": 1,
            "description": "Exact SDH gene identifier"
          },
          "species": {
            "maxLength": 160,
            "type": "string",
            "minLength": 1,
            "description": "Optional exact species constraint"
          },
          "version": {
            "maxLength": 255,
            "type": "string",
            "minLength": 1,
            "description": "Optional exact assembly constraint"
          }
        },
        "required": [
          "gene_id"
        ]
      }
    },
    {
      "name": "gene_context",
      "description": "Return assembly-scoped annotation, expression, epigenome, GWAS and metabolite evidence.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "gene_id": {
            "maxLength": 128,
            "type": "string",
            "minLength": 1,
            "description": "Exact SDH gene identifier"
          },
          "species": {
            "maxLength": 160,
            "type": "string",
            "minLength": 1,
            "description": "Exact species name"
          },
          "version": {
            "maxLength": 255,
            "type": "string",
            "minLength": 1,
            "description": "Exact assembly version"
          }
        },
        "required": [
          "gene_id",
          "species",
          "version"
        ]
      }
    },
    {
      "name": "sequence_fetch",
      "description": "Fetch exact assembly-scoped protein and/or CDS sequence from the local SDH database.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "gene_id": {
            "maxLength": 128,
            "type": "string",
            "minLength": 1,
            "description": "Exact SDH gene identifier"
          },
          "species": {
            "maxLength": 160,
            "type": "string",
            "minLength": 1,
            "description": "Exact species name"
          },
          "version": {
            "maxLength": 255,
            "type": "string",
            "minLength": 1,
            "description": "Exact assembly version"
          },
          "type": {
            "description": "Sequence type",
            "type": "string",
            "enum": [
              "protein",
              "cds",
              "both"
            ]
          }
        },
        "required": [
          "gene_id",
          "species",
          "version"
        ]
      }
    },
    {
      "name": "batch_gene_annotation",
      "description": "Annotate and compare multiple exact assembly-aware SDH genes: functional terms, expression, epigenome, GWAS and metabolic evidence with provenance and comparability checks.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "gene_ids": {
            "maxItems": 50,
            "items": {
              "maxLength": 128,
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]+$",
              "minLength": 1
            },
            "description": "Distinct exact SDH gene identifiers",
            "uniqueItems": true,
            "minItems": 1,
            "type": "array"
          },
          "species": {
            "maxLength": 160,
            "type": "string",
            "minLength": 1,
            "description": "Optional exact species constraint"
          },
          "version": {
            "maxLength": 255,
            "type": "string",
            "minLength": 1,
            "description": "Optional exact assembly constraint"
          }
        },
        "required": [
          "gene_ids"
        ]
      }
    },
    {
      "name": "module_catalog",
      "description": "Report Agent-accessible SDH modules.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {},
        "required": []
      }
    },
    {
      "name": "data_catalog",
      "description": "Inspect real SDH genome, transcriptome, epigenome, single-cell, metabolomics, GWAS, pangenome, functional-annotation, regulatory and downloadable-data inventories. Genome results distinguish strawberry hosts, strawberry pathogens and unclassified records, and expose stable assembly metadata plus verified module capabilities when available.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "domain": {
            "description": "Internal data domain",
            "type": "string",
            "enum": [
              "all",
              "genome",
              "transcriptome",
              "epigenome",
              "single_cell",
              "metabolomics",
              "gwas",
              "pangenome",
              "functional_annotation",
              "regulatory",
              "downloads",
              "coexpression",
              "crispr"
            ]
          },
          "query": {
            "maxLength": 500,
            "type": "string",
            "minLength": 1,
            "description": "Optional cultivar, species, assembly or dataset text"
          },
          "limit": {
            "type": "integer",
            "maximum": 20,
            "minimum": 1,
            "description": "Maximum entries or sample genes per domain"
          },
          "summary_only": {
            "description": "Return aggregate genome counts without assembly rows",
            "type": "boolean"
          }
        },
        "required": []
      }
    },
    {
      "name": "pangenome_query",
      "description": "Query the published SDH diploid Fragaria orthogroup catalogue, occupancy, composition, matrix and pan-gene members.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "operation": {
            "description": "Pangenome operation",
            "type": "string",
            "enum": [
              "status",
              "assemblies",
              "composition",
              "occupancy",
              "addition_profile",
              "matrix",
              "gene_search",
              "gene_detail"
            ]
          },
          "query": {
            "maxLength": 255,
            "type": "string",
            "minLength": 1,
            "description": "Optional pan-gene, Orthogroup or protein search"
          },
          "pan_gene_id": {
            "maxLength": 128,
            "type": "string",
            "minLength": 1,
            "description": "Exact SDH pan-gene identifier"
          },
          "assignment": {
            "description": "Assignment filter",
            "type": "string",
            "enum": [
              "all",
              "grouped",
              "unassigned_singleton"
            ]
          },
          "occupancy": {
            "type": "integer",
            "maximum": 7,
            "minimum": 1,
            "description": "Proteome occupancy"
          },
          "assembly": {
            "maxLength": 128,
            "type": "string",
            "minLength": 1,
            "description": "Exact pangenome assembly ID"
          },
          "limit": {
            "type": "integer",
            "maximum": 20,
            "minimum": 1,
            "description": "Maximum rows"
          }
        },
        "required": [
          "operation"
        ]
      }
    },
    {
      "name": "graph_variation_query",
      "description": "Query bounded pangenome graph alignments and validated Fvb1 SV/PAV site evidence.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "operation": {
            "description": "Graph evidence operation",
            "type": "string",
            "enum": [
              "status",
              "region",
              "sites",
              "site_detail"
            ]
          },
          "sequence": {
            "maxLength": 64,
            "type": "string",
            "minLength": 1,
            "description": "Reference sequence such as Fvb1"
          },
          "start": {
            "description": "1-based region start",
            "type": "number",
            "exclusiveMinimum": 0
          },
          "length": {
            "type": "integer",
            "maximum": 20000,
            "minimum": 1,
            "description": "Region length"
          },
          "query": {
            "maxLength": 255,
            "type": "string",
            "minLength": 1,
            "description": "Optional site, gene or sample search"
          },
          "stable_id": {
            "maxLength": 128,
            "type": "string",
            "minLength": 1,
            "description": "Exact graph-site stable identifier"
          },
          "evidence": {
            "maxLength": 64,
            "type": "string",
            "minLength": 1,
            "description": "Evidence status filter"
          },
          "annotation": {
            "maxLength": 64,
            "type": "string",
            "minLength": 1,
            "description": "Annotation overlap filter"
          },
          "te_context": {
            "maxLength": 64,
            "type": "string",
            "minLength": 1,
            "description": "TE-context filter"
          },
          "limit": {
            "type": "integer",
            "maximum": 20,
            "minimum": 1,
            "description": "Maximum sites"
          }
        },
        "required": [
          "operation"
        ]
      }
    },
    {
      "name": "single_cell_query",
      "description": "Query the SDH single-cell catalogue, markers, differential expression, gene profiles, GO results and defense evidence.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "operation": {
            "description": "Single-cell operation",
            "type": "string",
            "enum": [
              "catalog",
              "markers",
              "differential_expression",
              "gene",
              "go",
              "defense"
            ]
          },
          "dataset": {
            "maxLength": 64,
            "type": "string",
            "minLength": 1,
            "description": "Dataset accession"
          },
          "analysis": {
            "maxLength": 128,
            "type": "string",
            "minLength": 1,
            "description": "Analysis version"
          },
          "sample": {
            "maxLength": 128,
            "type": "string",
            "minLength": 1,
            "description": "Sample identifier"
          },
          "contrast": {
            "maxLength": 128,
            "type": "string",
            "minLength": 1,
            "description": "Contrast identifier"
          },
          "cell_type": {
            "maxLength": 128,
            "type": "string",
            "minLength": 1,
            "description": "Cell type identifier or label"
          },
          "gene": {
            "maxLength": 128,
            "type": "string",
            "minLength": 1,
            "description": "Exact gene identifier"
          },
          "passes_threshold": {
            "description": "Require the published DE threshold",
            "type": "boolean"
          },
          "limit": {
            "type": "integer",
            "maximum": 50,
            "minimum": 1,
            "description": "Maximum rows"
          }
        },
        "required": [
          "operation"
        ]
      }
    },
    {
      "name": "transcriptome_query",
      "description": "Query SDH transcriptome datasets and compare bounded assembly-specific gene expression profiles.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "operation": {
            "description": "Transcriptome operation",
            "type": "string",
            "enum": [
              "catalog",
              "gene",
              "compare"
            ]
          },
          "dataset": {
            "maxLength": 128,
            "type": "string",
            "minLength": 1,
            "description": "Exact transcriptome dataset slug"
          },
          "species": {
            "maxLength": 160,
            "type": "string",
            "minLength": 1,
            "description": "Exact species; must match the selected dataset"
          },
          "version": {
            "maxLength": 255,
            "type": "string",
            "minLength": 1,
            "description": "Exact assembly version; must match the selected dataset"
          },
          "gene": {
            "maxLength": 128,
            "type": "string",
            "minLength": 1,
            "description": "Exact dataset gene identifier"
          },
          "gene_ids": {
            "maxItems": 20,
            "items": {
              "maxLength": 128,
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]+$",
              "minLength": 1
            },
            "description": "Genes to compare",
            "uniqueItems": true,
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "operation"
        ]
      }
    },
    {
      "name": "epigenome_query",
      "description": "Query SDH epigenomics projects, chromatin-state models, genes and genomic regions.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "operation": {
            "description": "Epigenome operation",
            "type": "string",
            "enum": [
              "catalog",
              "project",
              "state_model",
              "examples",
              "gene",
              "region"
            ]
          },
          "project": {
            "maxLength": 64,
            "type": "string",
            "minLength": 1,
            "description": "Project accession"
          },
          "category": {
            "maxLength": 64,
            "type": "string",
            "minLength": 1,
            "description": "Assay category"
          },
          "gene": {
            "maxLength": 128,
            "type": "string",
            "minLength": 1,
            "description": "Exact gene identifier"
          },
          "species": {
            "maxLength": 160,
            "type": "string",
            "minLength": 1,
            "description": "Exact species"
          },
          "version": {
            "maxLength": 255,
            "type": "string",
            "minLength": 1,
            "description": "Exact assembly version"
          },
          "chromosome": {
            "maxLength": 128,
            "type": "string",
            "minLength": 1,
            "description": "Chromosome"
          },
          "start": {
            "description": "1-based region start",
            "type": "number",
            "exclusiveMinimum": 0
          },
          "end": {
            "description": "1-based region end",
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "operation"
        ]
      }
    },
    {
      "name": "sequence_analysis",
      "description": "Run bounded SDH batch sequence retrieval, Primer3 design, ORF finding or deterministic sequence analysis.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "operation": {
            "description": "Sequence operation",
            "type": "string",
            "enum": [
              "status",
              "batch_fetch",
              "primer_design",
              "orf_find",
              "toolkit"
            ]
          },
          "gene_ids": {
            "maxItems": 100,
            "items": {
              "maxLength": 128,
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]+$",
              "minLength": 1
            },
            "description": "Exact gene identifiers for batch retrieval",
            "uniqueItems": true,
            "minItems": 1,
            "type": "array"
          },
          "gene": {
            "maxLength": 128,
            "type": "string",
            "minLength": 1,
            "description": "Exact gene identifier for primer design"
          },
          "species": {
            "maxLength": 160,
            "type": "string",
            "minLength": 1,
            "description": "Exact species"
          },
          "version": {
            "maxLength": 255,
            "type": "string",
            "minLength": 1,
            "description": "Exact assembly version"
          },
          "sequence": {
            "maxLength": 50000,
            "type": "string",
            "minLength": 1,
            "description": "Nucleotide/protein sequence"
          },
          "sequence_id": {
            "maxLength": 128,
            "type": "string",
            "minLength": 1,
            "description": "Sequence label"
          },
          "type": {
            "description": "Batch sequence type",
            "type": "string",
            "enum": [
              "protein",
              "cds",
              "both"
            ]
          },
          "assay_type": {
            "description": "Primer assay type",
            "type": "string",
            "enum": [
              "qpcr",
              "pcr"
            ]
          },
          "sequence_type": {
            "description": "Sequence type",
            "type": "string",
            "enum": [
              "auto",
              "dna",
              "rna",
              "protein"
            ]
          }
        },
        "required": [
          "operation"
        ]
      }
    },
    {
      "name": "jbrowse_open",
      "description": "Prepare a navigation-only JBrowse link for a catalogued assembly and locus.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "species": {
            "maxLength": 160,
            "type": "string",
            "minLength": 1,
            "description": "Optional exact species name"
          },
          "version": {
            "maxLength": 255,
            "type": "string",
            "minLength": 1,
            "description": "Optional exact assembly version"
          },
          "assembly": {
            "maxLength": 160,
            "type": "string",
            "minLength": 1,
            "description": "Optional exact JBrowse assembly name"
          },
          "location": {
            "maxLength": 160,
            "type": "string",
            "minLength": 1,
            "description": "Optional ref:start-end location"
          },
          "gene_id": {
            "maxLength": 128,
            "type": "string",
            "minLength": 1,
            "description": "Optional exact gene identifier for assembly selection"
          }
        },
        "required": []
      }
    },
    {
      "name": "family_search",
      "description": "Find genes assigned to an exact gene-family name.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "family": {
            "maxLength": 128,
            "type": "string",
            "minLength": 1,
            "description": "Exact gene-family name"
          },
          "species": {
            "maxLength": 160,
            "type": "string",
            "minLength": 1,
            "description": "Optional species filter"
          }
        },
        "required": [
          "family"
        ]
      }
    },
    {
      "name": "tf_search",
      "description": "Find transcription factors or regulators by family and species.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "family": {
            "maxLength": 128,
            "type": "string",
            "minLength": 1,
            "description": "Optional exact TF/TR family"
          },
          "species": {
            "maxLength": 160,
            "type": "string",
            "minLength": 1,
            "description": "Optional species filter"
          },
          "type": {
            "description": "Regulator class",
            "type": "string",
            "enum": [
              "TF",
              "TR",
              "ALL"
            ]
          }
        },
        "required": []
      }
    },
    {
      "name": "mirna_search",
      "description": "Find predicted miRNA loci in a whitelisted assembly.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "assembly": {
            "maxLength": 64,
            "type": "string",
            "minLength": 1,
            "description": "Whitelisted assembly slug"
          },
          "family": {
            "maxLength": 128,
            "type": "string",
            "minLength": 1,
            "description": "Optional exact miRNA family"
          }
        },
        "required": []
      }
    },
    {
      "name": "synteny_search",
      "description": "Return pairwise syntenic context for a gene in a published Fragaria assembly.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "gene_id": {
            "maxLength": 191,
            "type": "string",
            "minLength": 1,
            "description": "Gene identifier in the input assembly"
          },
          "source_assembly": {
            "maxLength": 64,
            "type": "string",
            "minLength": 1,
            "description": "Published input assembly ID"
          },
          "target_assembly": {
            "maxLength": 64,
            "type": "string",
            "minLength": 1,
            "description": "Published target assembly ID"
          },
          "flank": {
            "type": "integer",
            "maximum": 10,
            "minimum": 0,
            "description": "Neighbouring genes on each side"
          }
        },
        "required": []
      }
    },
    {
      "name": "functional_enrichment",
      "description": "Run GO or KEGG over-representation analysis.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "analysis": {
            "description": "Enrichment namespace",
            "type": "string",
            "enum": [
              "go",
              "kegg"
            ]
          },
          "species": {
            "maxLength": 160,
            "type": "string",
            "minLength": 1,
            "description": "Exact species name"
          },
          "version": {
            "maxLength": 255,
            "type": "string",
            "minLength": 1,
            "description": "Exact assembly version"
          },
          "gene_ids": {
            "maxItems": 100,
            "items": {
              "maxLength": 128,
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]+$",
              "minLength": 1
            },
            "description": "Input gene set",
            "uniqueItems": true,
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "analysis",
          "species",
          "version",
          "gene_ids"
        ]
      }
    },
    {
      "name": "gwas_trait",
      "description": "Retrieve a published GWAS trait summary or exact marker detail.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "trait": {
            "description": "Supported published trait",
            "type": "string",
            "enum": [
              "yield",
              "fruit-size"
            ]
          },
          "marker_id": {
            "maxLength": 128,
            "type": "string",
            "minLength": 1,
            "description": "Optional exact marker identifier"
          }
        },
        "required": [
          "trait"
        ]
      }
    },
    {
      "name": "metabolite_search",
      "description": "Query the metabolomics catalogue, features, details, statistics or abundance matrix.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "operation": {
            "description": "Metabolomics operation",
            "type": "string",
            "enum": [
              "search",
              "catalog",
              "feature_detail",
              "statistics",
              "matrix"
            ]
          },
          "query": {
            "maxLength": 255,
            "type": "string",
            "minLength": 1,
